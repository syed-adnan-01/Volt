# ──────────────────────────────────────────────
# VOLT — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/volt_dev

# Redis
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK (backend only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Client Web SDK (Expo frontend)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# External service URLs
OSRM_BASE_URL=http://localhost:5000
CHARGER_API_URL=http://localhost:4001
ML_API_URL=http://localhost:4002
BATTERY_SERVICE_URL=http://localhost:4003
OPTIMIZER_SERVICE_URL=http://localhost:4004

# Logging
LOG_LEVEL=info

# OpenChargeMap (AI/ML service)
OPENCHARGEMAP_API_KEY=
# Lyzr AI (AI/ML service)
LYZR_API_KEY=
