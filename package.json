{
  "name": "volt",
  "version": "0.1.0",
  "private": true,
  "description": "VOLT — AI-Powered Predictive EV Journey Optimization Platform",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace=services/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:dev": "npm run test:dev --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=services/api"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.6"
  },
  "dependencies": {
    "expo-asset": "~11.0.3"
  }
}
